{
  "name": "dsh-mcp-manage",
  "version": "0.3.0",
  "private": true,
  "description": "MCP 服务器集合 + 设置面板「MCP管理」：一行一台服务器，显示工具清单与 token 占用，支持会话级懒启动与手写用途说明",
  "license": "MIT",
  "author": "hisence999",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hisence999/dsh-mcp-manage.git"
  },
  "homepage": "https://github.com/hisence999/dsh-mcp-manage#readme",
  "bugs": {
    "url": "https://github.com/hisence999/dsh-mcp-manage/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mcp",
    "lazy-loading",
    "cordis-plugin"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/panel.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
